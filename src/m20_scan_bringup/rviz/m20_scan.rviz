            imu_link:
              {}
            lidar_link:
              {}
            m20_front_camera_link:
              {}
            m20_rear_camera_link:
              {}
            rslidar_front:
              {}
            rslidar_rear:
              {}
          odom:
            {}
          sliding_map:
            {}
          world:
            {}
      Update Interval: 0
      Value: true
