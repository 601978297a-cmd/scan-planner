        odom:
          Value: true
        rslidar_front:
          Value: true
        rslidar_rear:
          Value: true
        sliding_map:
          Value: true
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
